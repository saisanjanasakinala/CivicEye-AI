# CivicEye AI — Backend environment variables
# Copy this file to .env and edit as needed

# Database (default: SQLite in project root)
DATABASE_URL=sqlite:///./civiceye.db

# JWT secret — CHANGE THIS in production
SECRET_KEY=civiceye-secret-key-change-in-production-2024

# Upload directory for evidence images
UPLOAD_DIR=uploads

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
